# ==============================================================================
# DIGITAL BLOOD DONATION AND EMERGENCY BLOOD AVAILABILITY MANAGEMENT PORTAL
# Bannari Amman Institute of Technology (BIT) - bitsathy.ac.in
# Environment Configuration Template
# ==============================================================================

# Node Environment & Server Ports
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Allowed College Domain (Strict Google Workspace domain)
ALLOWED_COLLEGE_DOMAIN=bitsathy.ac.in

# MongoDB Database Connection URL
MONGODB_URI=mongodb://127.0.0.1:27017/bit_blood_portal

# Session & JWT Secrets
JWT_SECRET=replace_with_a_secure_random_64_character_string_for_jwt_cookie_signing
JWT_EXPIRES_IN=24h

# Google Identity Services (OAuth 2.0 Web Client ID)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Public Google OAuth Web Client ID (same ID as server, needed by Vite)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Google Form & Apps Script HMAC Sync Secret
# Must match the FORM_SYNC_SECRET configured in Google Apps Script Script Properties
FORM_SYNC_SECRET=replace_with_a_secure_shared_hmac_secret_for_apps_script_sync

# Published Google Form URL (Presented to students if they attempt login without Form registration)
GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/1FAIpQLSc_EXAMPLE_BIT_BLOOD_REGISTRATION/viewform

# Official Email OTP / Magic Link Fallback Configuration (Optional / Configurable)
# Used when Google Workspace OAuth is unavailable or blocked for review
EMAIL_OTP_FALLBACK_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="BIT Blood Coordination Desk" <blood-desk@bitsathy.ac.in>

# Public portal URL used in verification and reset links
PUBLIC_API_URL=http://localhost:5000

# Standard Web Push (VAPID). Generate a key pair with `npx web-push generate-vapid-keys`.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:portal-admin@bitsathy.ac.in
VITE_WEB_PUSH_VAPID_PUBLIC_KEY=

# Coordinator & Admin Initial Provisioning (Comma-separated college emails)
INITIAL_ADMIN_EMAILS=
INITIAL_COORDINATOR_EMAILS=


# Availability Freshness Expiry (in days, defaults to 30 days)
AVAILABILITY_STALE_DAYS=30
