# Copy to server/.env. Fill in credentials from your approved providers.
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:5000
MONGODB_URI=mongodb://127.0.0.1:27017/bit_blood_portal
ALLOWED_COLLEGE_DOMAIN=bitsathy.ac.in
JWT_SECRET=replace-with-a-long-random-secret

# SMTP is required before email/password registration can send verification links.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Provision privileged accounts only through the server-side allowlist.
INITIAL_ADMIN_EMAILS=
INITIAL_COORDINATOR_EMAILS=
